/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# style.css and main.js are unversioned filenames, so they must revalidate.
# Cloudflare purges its edge cache on deploy, but browser caches are not
# purged — a long max-age here would strand visitors on stale CSS.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/img/*
  Cache-Control: public, max-age=604800
